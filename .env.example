# Copy to .env and fill in values. Never commit .env.

# --- Groq (LLM generation + grading) ---
GROQ_API_KEY=

# Model routing (see PRD Section 6 / CLAUDE.md).
# Small, high-RPD model: grading, arxiv query generation, candidate relevance checks.
GRADING_MODEL=llama-3.1-8b-instant
# Larger model, used only for the final user-facing answer.
GENERATION_MODEL=llama-3.3-70b-versatile

# --- Voyage AI (embeddings + reranking) ---
VOYAGE_API_KEY=

# Do not change after the Qdrant collection is created without re-ingesting.
VOYAGE_EMBED_MODEL=voyage-4-lite
VOYAGE_EMBED_DIM=1024
VOYAGE_RERANK_MODEL=rerank-2.5-lite
# Bounded concurrency for Voyage calls. The free tier is rate-limited, so prefer
# a few large batches over many small parallel ones (voyage-4-lite allows ~1M tokens/request).
VOYAGE_MAX_CONCURRENCY=2
# Max child chunks per embedding request (voyage-4-lite allows large batches).
VOYAGE_BATCH_SIZE=128

# --- Qdrant Cloud (vector store) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arxiv_chunks
# Sparse (BM25-style) model. Owned by the vectorstore module for BOTH upsert and query,
# so document and query IDF stay consistent.
SPARSE_MODEL=Qdrant/bm25

# --- SQLite (papers, chunks, sessions, messages) ---
SQLITE_DB_PATH=./backend/data/app.db

# --- Hugging Face (optional, reserved fallback) ---
HF_TOKEN=

# --- Ingestion / chunking ---
# Prefer arxiv HTML rendering for clean section boundaries; fall back to PyMuPDF on the
# PDF when HTML is missing (pre-Dec-2023 papers, PDF-only submissions) or conversion failed.
ARXIV_PREFER_HTML=true
ARXIV_USER_AGENT=arxiv-rag-chatbot/0.1 (contact: you@example.com)
# Child chunk window (the retrieval unit). Parents (whole sections) are stored in SQLite only.
CHILD_CHUNK_TOKENS=512
CHILD_CHUNK_OVERLAP=64
# Comma-separated section names dropped before chunking (case-insensitive substring match).
SECTION_DROP_LIST=references,bibliography,acknowledgements,funding,author contributions,conflict of interest
# Sections with fewer than this many prose chars are treated as equation-only and dropped.
EQUATION_MIN_PROSE_CHARS=150

# --- CRAG chat flow ---
CRAG_MAX_RETRIES=2
# Two-threshold grading band:
#   reranked score >= GRADE_HIGH_THRESHOLD -> sufficient   (skip LLM)
#   reranked score <= GRADE_LOW_THRESHOLD  -> insufficient (skip LLM)
#   in between                             -> call GRADING_MODEL as judge
GRADE_HIGH_THRESHOLD=0.6
GRADE_LOW_THRESHOLD=0.35
RERANK_CANDIDATE_COUNT=30
RERANK_TOP_K=5
# Small-to-big cap: distinct parent sections expanded into the generation context.
GENERATION_MAX_PARENTS=5
# Ask-mode corrective ingestion.
ASK_ARXIV_QUERY_COUNT=3
ASK_INGEST_CANDIDATES=3

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
