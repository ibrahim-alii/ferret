# Copy to .env and fill in values. Never commit .env.

# --- Groq (LLM generation + grading) ---
GROQ_API_KEY=

# Model routing (see PRD Section 6 / CLAUDE.md).
# Small, high-RPD model: grading, arxiv query generation, candidate relevance checks.
GRADING_MODEL=llama-3.1-8b-instant
# Larger model, used only for the final user-facing answer.
GENERATION_MODEL=llama-3.3-70b-versatile

# --- Dense embeddings (OpenAI by default, Gemini for local/dev testing) ---
# When true, embeddings come from Gemini instead of OpenAI (avoids OpenAI quota during
# local testing). Both providers must use the same dim (OPENAI_EMBED_DIM); re-ingest if
# you switch providers so query and stored vectors come from the same model.
USE_LOCAL_EMBEDDINGS=false

OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
# Gemini (used only when USE_LOCAL_EMBEDDINGS=true). gemini-embedding-001 supports
# configurable output dimensionality, set to OPENAI_EMBED_DIM below.
GEMINI_API_KEY=
GEMINI_EMBED_MODEL=gemini-embedding-001

# Shared dim for whichever provider is active. Do not change after the Qdrant collection
# is created without re-ingesting.
OPENAI_EMBED_DIM=1536
# Bounded concurrency for embedding calls (applies to the active provider).
OPENAI_MAX_CONCURRENCY=5
# Max child chunks per embedding request.
OPENAI_BATCH_SIZE=128

# --- Jina AI (reranking only) ---
# Get a free key at https://jina.ai/reranker (generous free token allotment).
JINA_API_KEY=
JINA_RERANK_MODEL=jina-reranker-v2-base-multilingual
# Bounded concurrency for Jina rerank calls.
JINA_MAX_CONCURRENCY=4
# Retry/backoff for transient rerank failures (429/5xx/network): wait = base * attempt.
JINA_RETRY_BASE_WAIT=2
JINA_TIMEOUT=30

# --- Qdrant Cloud (vector store) ---
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=arxiv_chunks
# Sparse (BM25-style) model. Owned by the vectorstore module for BOTH upsert and query,
# so document and query IDF stay consistent.
SPARSE_MODEL=Qdrant/bm25

# --- SQLite (papers, chunks, sessions, messages) ---
SQLITE_DB_PATH=./backend/data/app.db

# --- Hugging Face (optional, reserved fallback) ---
HF_TOKEN=

# --- Ingestion / chunking ---
# Prefer arxiv HTML rendering for clean section boundaries; fall back to PyMuPDF on the
# PDF when HTML is missing (pre-Dec-2023 papers, PDF-only submissions) or conversion failed.
ARXIV_PREFER_HTML=true
ARXIV_USER_AGENT=arxiv-rag-chatbot/0.1 (contact: you@example.com)
# Child chunk window (the retrieval unit). Parents (whole sections) are stored in SQLite only.
CHILD_CHUNK_TOKENS=512
CHILD_CHUNK_OVERLAP=64
# Comma-separated section names dropped before chunking (case-insensitive substring match).
SECTION_DROP_LIST=references,bibliography,acknowledgements,funding,author contributions,conflict of interest
# Sections with fewer than this many prose chars are treated as equation-only and dropped.
EQUATION_MIN_PROSE_CHARS=150

# --- CRAG chat flow ---
CRAG_MAX_RETRIES=2
# Two-threshold grading band:
#   reranked score >= GRADE_HIGH_THRESHOLD -> sufficient   (skip LLM)
#   reranked score <= GRADE_LOW_THRESHOLD  -> insufficient (skip LLM)
#   in between                             -> call GRADING_MODEL as judge
GRADE_HIGH_THRESHOLD=0.6
GRADE_LOW_THRESHOLD=0.35
RERANK_CANDIDATE_COUNT=30
RERANK_TOP_K=5
# Candidates kept after reranking, fed to the Ask-mode MMR de-dup pass (which then
# trims to RERANK_TOP_K). Must be >= RERANK_TOP_K.
RERANK_POOL_K=12
# MMR relevance/diversity tradeoff for Ask mode: 1.0 = pure rerank order, lower =
# more aggressive de-duplication of near-identical chunks across similar papers.
MMR_LAMBDA=0.7
# Small-to-big cap: distinct parent sections expanded into the generation context.
GENERATION_MAX_PARENTS=5
# Multimodal output: directory for figure images extracted from PDF-only papers
# (served at /media), and the max number of tables/figures baked into one answer.
MEDIA_DIR=./backend/data/media
MEDIA_MAX_ITEMS=6
# Token budgets for the final Groq generation request. Keep input under the model's
# per-request / free-tier TPM limit (avoids HTTP 413 "request too large"). On a 413 the
# generate node retries with a halved context budget.
GENERATION_MAX_CONTEXT_TOKENS=6000
GENERATION_MAX_HISTORY_TOKENS=1500
# Ask-mode corrective ingestion.
ASK_ARXIV_QUERY_COUNT=3
ASK_INGEST_CANDIDATES=3
# How many corrective papers to ingest concurrently (bounded; network-bound work).
ASK_INGEST_CONCURRENCY=2
# Timeout (s) for arxiv search HTTP calls in the deep-dive fallback.
ARXIV_TIMEOUT=30

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000
