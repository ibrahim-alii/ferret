# Build context is the repo root for both images; keep it lean.
.git
.gitignore

# Python
**/__pycache__
*.py[cod]
*.egg-info
.venv
venv
.pytest_cache
.mypy_cache
.coverage*
htmlcov

# Node
**/node_modules

# Secrets — never bake into an image
.env
.env.*
frontend/.env

# Local data / ingested artifacts
*.db
*.sqlite*
backend/data/*.db
backend/data/*.pdf
backend/data/*.html
backend/data/*.xml
qdrant_storage/
evals/reports/

# Tests aren't needed at runtime
tests/
**/tests/

# Tooling / docs
.claude/
*.log
logs/
